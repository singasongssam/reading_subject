# 교육부 고시 제2022-33호 [별책 18] 중학교 선택 교과 교육과정
# 사회과.ttl의 RDF/RDFS/OWL 표현 체계를 참조하였으며 환경·보건·진로와 직업 3과목의 13개 내용 영역, 핵심 아이디어, 3범주 내용 요소, 전체 성취기준을 담음.
# 원문 HWP의 일부 항목에는 붙어 쓰기와 띄어쓰기 등의 출판 원문 표기가 그대로 반영됨.

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ex: <https://example.org/curriculum/middle-school-electives#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:CareerAreaRestriction a owl:Restriction ;
    owl:onClass ex:LearningArea ;
    owl:onProperty ex:hasArea ;
    owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger .

ex:EnvironmentAreaRestriction a owl:Restriction ;
    owl:onClass ex:LearningArea ;
    owl:onProperty ex:hasArea ;
    owl:qualifiedCardinality "5"^^xsd:nonNegativeInteger .

ex:HealthAreaRestriction a owl:Restriction ;
    owl:onClass ex:LearningArea ;
    owl:onProperty ex:hasArea ;
    owl:qualifiedCardinality "5"^^xsd:nonNegativeInteger .

ex:MiddleSchoolElectiveCurriculum a owl:Ontology ;
    dc:description "교육부 고시 제2022-33호 [별책 18]의 환경·보건·진로와 직업 과목을 구조화한 자료. 핵심 아이디어·내용 요소·성취기준은 해당 원문을 기준으로 작성."@ko ;
    dc:title "2022 개정 중학교 선택 교과 교육과정 RDF/RDFS/OWL"@ko .

ex:associatedArea a owl:ObjectProperty ;
    rdfs:label "관련 영역"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range ex:LearningArea .

ex:belongsToSubject a owl:ObjectProperty ;
    rdfs:label "소속 과목"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range ex:Subject .

ex:code a owl:DatatypeProperty ;
    rdfs:label "성취기준 코드"@ko ;
    rdfs:range xsd:string .

ex:description a owl:DatatypeProperty ;
    rdfs:label "설명"@ko ;
    rdfs:range xsd:string .

ex:developsCompetency a owl:ObjectProperty ;
    rdfs:label "함양 역량"@ko ;
    rdfs:domain ex:Subject ;
    rdfs:range ex:Competency .

ex:hasAchievementStandard a owl:ObjectProperty ;
    rdfs:label "성취기준"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:AchievementStandard .

ex:hasContentElement a owl:ObjectProperty ;
    rdfs:label "내용 요소"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:ContentElement .

ex:hasCoreIdea a owl:ObjectProperty ;
    rdfs:label "핵심 아이디어"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:CoreIdea .

ex:relatedToArea a owl:ObjectProperty ;
    rdfs:label "관련 영역"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:LearningArea .

ex:standardText a owl:DatatypeProperty ;
    rdfs:label "성취기준 원문"@ko ;
    rdfs:range xsd:string .

ex:CareerCompetency1 a ex:Competency ;
    rdfs:label "진로 개발 역량"@ko .

ex:CareerExploration_Idea1 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 1"@ko ;
    ex:description "직업 세계는 사회 환경 변화를 반영한다."@ko .

ex:CareerExploration_Idea2 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 2"@ko ;
    ex:description "자신에게 적합한 진로 기회를 발견하기 위해서는 폭넓은 진로 정보와 학습이 필요하다."@ko .

ex:CareerExploration_Idea3 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 3"@ko ;
    ex:description "다양한 경험과 진로 활동 참여는 진로 탐색의 주도성을 높인다."@ko .

ex:CareerExploration_Idea4 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 4"@ko ;
