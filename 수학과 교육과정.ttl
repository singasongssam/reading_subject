# 2022 개정 수학과 교육과정 RDF/RDFS/OWL 구조화 예시
# 참고 구조: 업로드된 사회과.ttl의 클래스·속성·OWL 제약 방식
# 근거: 교육부 고시 제2022-33호 [별책 8] 수학과 교육과정
# 초·중학교 4개 영역의 핵심 아이디어는 원문 문장을 기록.
# 지식·이해는 학년군별로, 과정·기능·가치·태도 및 성취기준은 대표 사례만 구조화.
# 고등학교 공통·선택 과목은 원문 목차에 등장하는 과목명을 포함.
# 전체 교육과정의 성취기준·내용 요소를 빠짐없이 전사한 완전판은 아님.

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ex: <https://example.org/curriculum/mathematics#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Mathematics a ex:MathematicsSubject,
        ex:Subject ;
    rdfs:label "수학"@ko ;
    ex:description "수학의 개념, 원리, 법칙을 이해하고 현상을 수학적으로 관찰·해석하며 논리적으로 사고하고 합리적으로 문제를 해결하는 능력과 태도를 기르는 교과"@ko ;
    ex:developsCompetency ex:Communication,
        ex:Connection,
        ex:InformationProcessing,
        ex:ProblemSolving,
        ex:Reasoning ;
    ex:hasArea ex:ChangeRelations,
        ex:DataProbability,
        ex:GeometryMeasurement,
        ex:NumberOperations ;
    ex:hasCourse ex:CareerElectiveCourse01,
        ex:CareerElectiveCourse02,
        ex:CareerElectiveCourse03,
        ex:CareerElectiveCourse04,
        ex:CareerElectiveCourse05,
        ex:CommonCourse01,
        ex:CommonCourse02,
        ex:CommonCourse03,
        ex:CommonCourse04,
        ex:ConvergenceElectiveCourse01,
        ex:ConvergenceElectiveCourse02,
        ex:ConvergenceElectiveCourse03,
        ex:GeneralElectiveCourse01,
        ex:GeneralElectiveCourse02,
        ex:GeneralElectiveCourse03 .

ex:MathematicsCurriculum a owl:Ontology ;
    dc:description "교육부 고시 제2022-33호 [별책 8] 수학과 교육과정에 기초한 학습용 구조화 모델. 내용 요소와 성취기준은 대표 사례를 수록함."@ko ;
    dc:title "2022 개정 수학과 교육과정 RDF/RDFS/OWL 구조화 예시"@ko .

ex:achievementForGrade a owl:ObjectProperty ;
    rdfs:label "성취기준 학년군"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range ex:GradeBand .

ex:associatedArea a owl:ObjectProperty ;
    rdfs:label "관련 영역"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range ex:LearningArea .

ex:belongsToGradeBand a owl:ObjectProperty ;
    rdfs:label "학년군"@ko ;
    rdfs:domain ex:ContentElement ;
    rdfs:range ex:GradeBand .

ex:code a owl:DatatypeProperty ;
    rdfs:label "성취기준 코드"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range <https://example.org/curriculum/mathematics#http://www.w3.org/2001/XMLSchema#string> .

ex:description a owl:DatatypeProperty ;
    rdfs:label "설명"@ko ;
    rdfs:range <https://example.org/curriculum/mathematics#http://www.w3.org/2001/XMLSchema#string> .

ex:developsCompetency a owl:ObjectProperty ;
    rdfs:label "함양 역량"@ko ;
    rdfs:domain ex:Subject ;
    rdfs:range ex:Competency .

ex:gradeBand a owl:DatatypeProperty ;
    rdfs:label "학년군"@ko ;
    rdfs:domain ex:ContentElement ;
    rdfs:range <https://example.org/curriculum/mathematics#http://www.w3.org/2001/XMLSchema#string> .

ex:hasAchievementStandard a owl:ObjectProperty ;
    rdfs:label "성취기준"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:AchievementStandard .

ex:hasCategory a owl:ObjectProperty ;
    rdfs:label "과목 유형"@ko ;
    rdfs:domain ex:Course ;
    rdfs:range ex:CourseCategory .

ex:hasContentElement a owl:ObjectProperty ;
    rdfs:label "내용 요소"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:ContentElement .

ex:hasCoreIdea a owl:ObjectProperty ;
    rdfs:label "핵심 아이디어"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:CoreIdea .

ex:hasCourse a owl:ObjectProperty ;
    rdfs:label "개설 과목"@ko ;
    rdfs:domain ex:Subject ;
    rdfs:range ex:Course .

ex:relatedToArea a owl:ObjectProperty ;
    rdfs:label "관련 영역"@ko ;
    rdfs:domain ex:LearningArea ;
    rdfs:range ex:LearningArea .

ex:standardText a owl:DatatypeProperty ;
    rdfs:label "성취기준 원문"@ko ;
    rdfs:domain ex:AchievementStandard ;
    rdfs:range <https://example.org/curriculum/mathematics#http://www.w3.org/2001/XMLSchema#string> .

ex:CareerElectiveCourse01 a ex:Course ;
    rdfs:label "미적분Ⅱ"@ko ;
    ex:hasCategory ex:CareerElective .

ex:CareerElectiveCourse02 a ex:Course ;
    rdfs:label "기하"@ko ;
    ex:hasCategory ex:CareerElective .

ex:CareerElectiveCourse03 a ex:Course ;
    rdfs:label "경제 수학"@ko ;
    ex:hasCategory ex:CareerElective .

ex:CareerElectiveCourse04 a ex:Course ;
    rdfs:label "인공지능 수학"@ko ;
    ex:hasCategory ex:CareerElective .

ex:CareerElectiveCourse05 a ex:Course ;
    rdfs:label "직무 수학"@ko ;
    ex:hasCategory ex:CareerElective .

ex:ChangeRelationsCoreIdea1 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 1"@ko ;
    ex:description "변화하는 현상에 반복적인 요소로 들어있는 규칙은 수나 식으로 표현될 수 있으며, 규칙을 탐구하는 것은 수학적으로 추측하고 일반화하는 데 기반이 된다."@ko .

ex:ChangeRelationsCoreIdea2 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 2"@ko ;
    ex:description "동치 관계, 대응 관계, 비례 관계 등은 여러 현상에 들어있는 대상들 사이의 다양한 관계를 기술하고 복잡한 문제를 해결하는 데 유용하게 활용된다."@ko .

ex:ChangeRelationsCoreIdea3 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 3"@ko ;
    ex:description "수와 그 계산은 문자와 식을 사용하여 일반화되며, 특정한 관계를 만족시키는 미지의 값은 방정식과 부등식을 해결하는 적절한 절차를 거쳐 구해진다."@ko .

ex:ChangeRelationsCoreIdea4 a ex:CoreIdea ;
    rdfs:label "핵심 아이디어 4"@ko ;
    ex:description "한 양이 변함에 따라 다른 양이 하나씩 정해지는 두 양 사이의 대응 관계를 나타내는 함수와 그 그래프는 변화하는 현상 속의 다양한 관계를 수학적으로 표현한다."@ko .

ex:ChangeRelations_Attitude_01 a ex:ValueAttitude ;
    rdfs:label "규칙, 동치 관계 탐구에 대한 흥미"@ko .

ex:ChangeRelations_Attitude_02 a ex:ValueAttitude ;
    rdfs:label "대응 관계, 비 표현의 편리함 인식"@ko .

ex:ChangeRelations_Attitude_03 a ex:ValueAttitude ;
    rdfs:label "실생활, 사회 및 자연 현상과 관련된 문제를 수학적 모델링을 통해 해결하려는 도전적인 태도"@ko .

ex:ChangeRelations_Attitude_04 a ex:ValueAttitude ;
    rdfs:label "타당한 근거에 따라 논리적으로 설명하는 태도"@ko .

