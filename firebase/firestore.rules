rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { 
      return request.auth != null; 
    }
    
    function getUserData() { 
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isActive() { 
      return signedIn() && (getUserData().active == true); 
    }
    
    function isAdmin() { 
      return isActive() && (getUserData().role == 'admin'); 
    }

    // 사용자 프로필 컬렉션
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.active == resource.data.active);
    }

    // 교육과정, 독서전략, 가네 수업사태, 텍스트 유형, 온톨로지 버전 등 마스터 데이터
    match /{coll}/{doc=**} {
      allow read: if isActive() && coll in [
        'subjects',
        'curriculumNodes',
        'readingFunctions',
        'readingStrategies',
        'textTypes',
        'gagneEvents',
        'ontologyVersions'
      ];
      allow write: if isAdmin() && coll in [
        'subjects',
        'curriculumNodes',
        'readingFunctions',
        'readingStrategies',
        'textTypes',
        'gagneEvents',
        'ontologyVersions',
        'promptTemplates',
        'appConfig'
      ];
    }

    // 교사 읽기자료 산출물
    match /materials/{id} { 
      allow read, write: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid); 
      allow read: if isAdmin(); 
    }

    // 교사 수업지도안 산출물
    match /lessonPlans/{id} { 
      allow read, write: if isActive() && (resource == null || resource.data.ownerUid == request.auth.uid); 
      allow read: if isAdmin(); 
    }
  }
}
